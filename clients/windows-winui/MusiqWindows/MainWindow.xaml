<?xml version="1.0" encoding="utf-8" ?>
<Window
    x:Class="MusiqWindows.MainWindow"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:animatedvisuals="using:Microsoft.UI.Xaml.Controls.AnimatedVisuals"
    Title="musiQ"
    mc:Ignorable="d">
    <Window.SystemBackdrop>
        <MicaBackdrop />
    </Window.SystemBackdrop>

    <Grid x:Name="RootGrid" SizeChanged="RootGrid_SizeChanged">
        <Grid.RowDefinitions>
            <RowDefinition Height="48" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TitleBar
            x:Name="AppTitleBar"
            Title="musiQ"
            Subtitle="Library"
            BackRequested="TitleBar_BackRequested"
            IsBackButtonVisible="{x:Bind NavFrame.CanGoBack, Mode=OneWay}"
            IsPaneToggleButtonVisible="True"
            PaneToggleRequested="TitleBar_PaneToggleRequested">
            <TitleBar.IconSource>
                <ImageIconSource ImageSource="Assets/AppIcon.ico" />
            </TitleBar.IconSource>
            <TitleBar.Content>
                <AutoSuggestBox
                    x:Name="LibrarySearchBox"
                    MinWidth="200"
                    VerticalAlignment="Center"
                    PlaceholderText="Search Local"
                    TextChanged="LibrarySearchBox_TextChanged"
                    Visibility="Collapsed">
                    <AutoSuggestBox.QueryIcon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </TitleBar.Content>
            <TitleBar.RightHeader>
                <SplitButton
                    x:Name="LibrarySourceButton"
                    Padding="8,4"
                    MinWidth="0"
                    Height="32"
                    VerticalAlignment="Center"
                    ToolTipService.ToolTip="Current library"
                    Click="LibrarySourceButton_Click">
                    <StackPanel Orientation="Horizontal" Spacing="6">
                        <Image x:Name="LibrarySourceImage" Width="16" Height="16" Visibility="Collapsed" />
                        <FontIcon x:Name="LibrarySourceFontIcon" Width="16" Height="16" FontSize="16" Glyph="&#xE8D6;" />
                        <TextBlock x:Name="LibrarySourceText" Text="Local" VerticalAlignment="Center" />
                    </StackPanel>
                    <SplitButton.Flyout>
                        <MenuFlyout x:Name="LibrarySourceFlyout" Placement="BottomEdgeAlignedRight" Opening="LibrarySourceFlyout_Opening" />
                    </SplitButton.Flyout>
                </SplitButton>
            </TitleBar.RightHeader>
        </TitleBar>

        <NavigationView
            x:Name="NavView"
            Grid.Row="1"
            IsBackButtonVisible="Collapsed"
            IsPaneToggleButtonVisible="False"
            SelectionChanged="NavView_SelectionChanged">
            <!--
              MenuItems is intentionally left empty here — it's rebuilt in
              code (RebuildLibraryMenuItems) every time the selected library
              source (Local/Navidrome/Plex) changes, since the set of
              sections shown depends on that.
            -->
            <!--
              Native pane search slot (renders above the menu items per
              Microsoft's own NavigationView docs) — a global search, distinct
              from the title bar's box which is scoped to whatever section is
              currently open. Submitting a query here always jumps to Local
              Tracks and filters there, since that's the only section with
              real searchable data today.
            -->
            <NavigationView.AutoSuggestBox>
                <AutoSuggestBox
                    x:Name="GlobalSearchBox"
                    PlaceholderText="Search everywhere"
                    QuerySubmitted="GlobalSearchBox_QuerySubmitted">
                    <AutoSuggestBox.QueryIcon>
                        <AnimatedIcon>
                            <AnimatedIcon.Source>
                                <animatedvisuals:AnimatedFindVisualSource />
                            </AnimatedIcon.Source>
                            <AnimatedIcon.FallbackIconSource>
                                <SymbolIconSource Symbol="Find" />
                            </AnimatedIcon.FallbackIconSource>
                        </AnimatedIcon>
                    </AutoSuggestBox.QueryIcon>
                </AutoSuggestBox>
            </NavigationView.AutoSuggestBox>
            <NavigationView.FooterMenuItems>
                <NavigationViewItem
                    x:Name="OfflineNavItem"
                    Content="Offline"
                    Tag="offline"
                    Visibility="Collapsed">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE709;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Downloads" Tag="downloads">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE896;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
                <NavigationViewItem Content="Now Playing" Tag="nowplaying">
                    <NavigationViewItem.Icon>
                        <FontIcon Glyph="&#xE8D6;" />
                    </NavigationViewItem.Icon>
                </NavigationViewItem>
            </NavigationView.FooterMenuItems>
            <Frame x:Name="NavFrame" />
        </NavigationView>
    </Grid>
</Window>
