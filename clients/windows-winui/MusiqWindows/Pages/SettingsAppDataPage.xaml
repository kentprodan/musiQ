<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.SettingsAppDataPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Padding="24,16,0,0" VerticalAlignment="Center">
            <HyperlinkButton Padding="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ElementSoundMode="FocusOnly" Click="BackToSettingsHome_Click">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock Text="&gt;" Style="{StaticResource TitleTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock x:Name="SectionLabelText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000"
                    Padding="24,0,24,24"
                    Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock
                        Text="musiQ keeps its own data — the library database, settings, and cached art — in a single app-managed folder. A setup step to choose this folder yourself (for example a musiQ folder inside your Music folder, which can double as a scanned library folder) is planned but not built yet; today it always lives in the app's own data folder below."
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="1,0,0,6" />

                    <controls:SettingsCard
                        Header="App data folder"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8B7;}"
                        HorizontalContentAlignment="Left"
                        ContentAlignment="Vertical">
                        <TextBlock Text="{x:Bind ViewModel.AppDataFolder}" IsTextSelectionEnabled="True" Opacity="0.7" TextWrapping="Wrap" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Header="Library database"
                        HeaderIcon="{ui:FontIcon Glyph=&#xE8F1;}"
                        HorizontalContentAlignment="Left"
                        ContentAlignment="Vertical">
                        <TextBlock Text="{x:Bind ViewModel.DatabasePath}" IsTextSelectionEnabled="True" Opacity="0.7" TextWrapping="Wrap" />
                    </controls:SettingsCard>

                    <controls:SettingsCard
                        Header="Export/import settings"
                        Description="Exports window size and theme only — Plex/Navidrome logins stay in Windows' Credential Locker and are never included."
                        HeaderIcon="{ui:FontIcon Glyph=&#xE896;}">
                        <StackPanel Orientation="Horizontal" Spacing="8">
                            <Button x:Name="ExportSettingsButton" Content="Export…" Click="ExportSettingsButton_Click" />
                            <Button x:Name="ImportSettingsButton" Content="Import…" Click="ImportSettingsButton_Click" />
                        </StackPanel>
                    </controls:SettingsCard>

                    <TextBlock x:Name="SettingsIoStatusText" Opacity="0.7" />
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
