<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.SourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MusiqWindows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Sources" />

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <StackPanel Spacing="20">
                <StackPanel Spacing="8">
                    <TextBlock Text="Local folders" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />
                    <ListView
                        ItemsSource="{x:Bind ViewModel.ScannedFolders}"
                        SelectionMode="None"
                        Height="120">
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="x:String">
                                <TextBlock Text="{x:Bind}" Padding="12,8" />
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Plex" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="PlexServerUrlBox" Header="Server URL" PlaceholderText="http://192.168.1.10:32400" Width="260" />
                        <PasswordBox x:Name="PlexTokenBox" Header="Token" Width="200" />
                        <Button
                            x:Name="PlexConnectButton"
                            Content="Connect"
                            Click="PlexConnectButton_Click"
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind ViewModel.CanConnectToPlex, Mode=OneWay}" />
                        <Button
                            Content="Forget"
                            Command="{x:Bind ViewModel.DisconnectPlexCommand}"
                            VerticalAlignment="Bottom"
                            Visibility="{x:Bind ViewModel.IsPlexConnected, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsConnectingToPlex, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.PlexStatusMessage, Mode=OneWay}" Opacity="0.7" />

                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlexLibraries}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Title}" Tag="{Binding}" Click="PlexLibraryButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Artists" Opacity="0.7" FontSize="12" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlexArtists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding}" Click="PlexArtistButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Albums" Opacity="0.7" FontSize="12" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.PlexAlbums}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="PlexAlbumButton_Click">
                                    <StackPanel Spacing="4">
                                        <Image Source="{Binding ArtUrl}" Width="80" Height="80" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Name}" MaxWidth="80" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Artist}" Opacity="0.7" FontSize="11" MaxWidth="80" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.PlexTracks}"
                        SelectionMode="None"
                        Height="300">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Artist" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Album" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:PlexTrackDisplay">
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Artist}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Album}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Duration}" />
                                    <Button
                                        Grid.Column="4"
                                        Padding="8,4"
                                        Tag="{x:Bind Raw}"
                                        Click="PlexTrackPlayButton_Click">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>

                <StackPanel Spacing="8">
                    <TextBlock Text="Navidrome" Style="{StaticResource SubtitleTextBlockStyle}" />
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBox x:Name="NavidromeServerUrlBox" Header="Server URL" PlaceholderText="http://192.168.1.10:4533" Width="220" />
                        <TextBox x:Name="NavidromeUsernameBox" Header="Username" Width="140" />
                        <PasswordBox x:Name="NavidromePasswordBox" Header="Password" Width="160" />
                        <Button
                            x:Name="NavidromeConnectButton"
                            Content="Connect"
                            Click="NavidromeConnectButton_Click"
                            VerticalAlignment="Bottom"
                            IsEnabled="{x:Bind ViewModel.CanConnectToNavidrome, Mode=OneWay}" />
                        <Button
                            Content="Forget"
                            Command="{x:Bind ViewModel.DisconnectNavidromeCommand}"
                            VerticalAlignment="Bottom"
                            Visibility="{x:Bind ViewModel.IsNavidromeConnected, Mode=OneWay}" />
                        <ProgressRing IsActive="{x:Bind ViewModel.IsConnectingToNavidrome, Mode=OneWay}" Width="20" Height="20" VerticalAlignment="Bottom" />
                    </StackPanel>
                    <TextBlock Text="{x:Bind ViewModel.NavidromeStatusMessage, Mode=OneWay}" Opacity="0.7" />

                    <TextBlock Text="Folders" Opacity="0.7" FontSize="12" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavidromeFolders}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding}" Click="NavidromeFolderButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Artists" Opacity="0.7" FontSize="12" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavidromeArtists}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Content="{Binding Name}" Tag="{Binding}" Click="NavidromeArtistButton_Click" />
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Text="Albums" Opacity="0.7" FontSize="12" />
                    <ItemsControl ItemsSource="{x:Bind ViewModel.NavidromeAlbums}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate>
                                <StackPanel Orientation="Horizontal" Spacing="8" />
                            </ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Tag="{Binding}" Click="NavidromeAlbumButton_Click">
                                    <StackPanel Spacing="4">
                                        <Image Source="{Binding ArtUrl}" Width="80" Height="80" Stretch="UniformToFill" />
                                        <TextBlock Text="{Binding Name}" MaxWidth="80" TextWrapping="Wrap" />
                                        <TextBlock Text="{Binding Artist}" Opacity="0.7" FontSize="11" MaxWidth="80" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <ListView
                        ItemsSource="{x:Bind ViewModel.NavidromeSongs}"
                        SelectionMode="None"
                        Height="300">
                        <ListView.HeaderTemplate>
                            <DataTemplate>
                                <Grid Padding="12,4" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="Title" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="1" Text="Artist" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="2" Text="Album" FontWeight="SemiBold" />
                                    <TextBlock Grid.Column="3" Text="Duration" FontWeight="SemiBold" />
                                </Grid>
                            </DataTemplate>
                        </ListView.HeaderTemplate>
                        <ListView.ItemTemplate>
                            <DataTemplate x:DataType="viewmodels:NavidromeSongDisplay">
                                <Grid Padding="12,8" ColumnSpacing="12">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="3*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="2*" />
                                        <ColumnDefinition Width="80" />
                                        <ColumnDefinition Width="48" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Grid.Column="0" Text="{x:Bind Title}" />
                                    <TextBlock Grid.Column="1" Text="{x:Bind Artist}" />
                                    <TextBlock Grid.Column="2" Text="{x:Bind Album}" />
                                    <TextBlock Grid.Column="3" Text="{x:Bind Duration}" />
                                    <Button
                                        Grid.Column="4"
                                        Padding="8,4"
                                        Tag="{x:Bind Raw}"
                                        Click="NavidromeSongPlayButton_Click">
                                        <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="12" />
                                    </Button>
                                </Grid>
                            </DataTemplate>
                        </ListView.ItemTemplate>
                    </ListView>
                </StackPanel>
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Page>
