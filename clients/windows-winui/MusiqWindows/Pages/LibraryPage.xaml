<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MusiqWindows.ViewModels"
    mc:Ignorable="d">

    <Grid x:Name="LibraryPageRoot" Padding="24,16,24,16" RowSpacing="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Orientation="Horizontal" Spacing="12" VerticalAlignment="Center">
            <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" VerticalAlignment="Center" />
            <Button x:Name="ScanFolderButton" Content="Scan Folder…" Click="ScanFolderButton_Click" />
            <Button x:Name="EditSelectedButton" Content="Edit Selected…" Click="EditSelectedButton_Click" />
            <Button x:Name="RenameSelectedButton" Content="Rename Selected…" Click="RenameSelectedButton_Click" />
            <ComboBox
                x:Name="SortFieldComboBox"
                Header="Sort by"
                SelectedIndex="0"
                SelectionChanged="SortFieldComboBox_SelectionChanged">
                <ComboBoxItem Content="Title" />
                <ComboBoxItem Content="Artist" />
                <ComboBoxItem Content="Album" />
                <ComboBoxItem Content="Duration" />
            </ComboBox>
            <Button
                x:Name="SortDirectionButton"
                VerticalAlignment="Bottom"
                Click="SortDirectionButton_Click"
                ToolTipService.ToolTip="Toggle sort direction">
                <FontIcon x:Name="SortDirectionIcon" FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70E;" />
            </Button>
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="20" Height="20" />
        </StackPanel>

        <TextBlock Grid.Row="1" Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />

        <ListView x:Name="TracksListView" Grid.Row="2" ItemsSource="{x:Bind ViewModel.Tracks}" SelectionMode="Extended">
            <ListView.HeaderTemplate>
                <DataTemplate>
                    <Grid Padding="12,4" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="1" Text="Title" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="2" Text="Artist" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="3" Text="Album" FontWeight="SemiBold" />
                        <TextBlock Grid.Column="4" Text="Duration" FontWeight="SemiBold" />
                    </Grid>
                </DataTemplate>
            </ListView.HeaderTemplate>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TrackItem">
                    <Grid Padding="12,8" ColumnSpacing="12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="3*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="2*" />
                            <ColumnDefinition Width="80" />
                            <ColumnDefinition Width="48" />
                            <ColumnDefinition Width="48" />
                        </Grid.ColumnDefinitions>
                        <Image
                            Grid.Column="0"
                            Width="40"
                            Height="40"
                            Source="{x:Bind ArtUrl}"
                            Stretch="UniformToFill" />
                        <TextBlock Grid.Column="1" Text="{x:Bind Title}" />
                        <TextBlock Grid.Column="2" Text="{x:Bind Artist}" />
                        <TextBlock Grid.Column="3" Text="{x:Bind Album}" />
                        <TextBlock Grid.Column="4" Text="{x:Bind Duration}" />
                        <Button
                            Grid.Column="5"
                            Padding="8,4"
                            Command="{Binding DataContext.PlayTrackCommand, ElementName=LibraryPageRoot}"
                            CommandParameter="{Binding}">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="12" />
                        </Button>
                        <Button
                            Grid.Column="6"
                            Padding="8,4"
                            Tag="{x:Bind}"
                            Click="EditTrackButton_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE70F;" FontSize="12" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ContentDialog
            x:Name="EditTrackDialog"
            Title="Edit tags"
            PrimaryButtonText="Save"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <TextBox x:Name="EditTitleBox" Header="Title" />
                <TextBox x:Name="EditArtistBox" Header="Artist" />
                <TextBox x:Name="EditAlbumBox" Header="Album" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="BatchEditDialog"
            Title="Edit tags for selected tracks"
            PrimaryButtonText="Save"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <TextBlock Text="Leave a field blank to keep each track's existing value." Opacity="0.7" TextWrapping="Wrap" />
                <TextBox x:Name="BatchArtistBox" Header="Artist" />
                <TextBox x:Name="BatchAlbumBox" Header="Album" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="RenamePatternDialog"
            Title="Rename selected tracks"
            PrimaryButtonText="Rename"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock Opacity="0.7" TextWrapping="Wrap">
                    <Run Text="Files move into the folder you just picked, using this pattern. Placeholders:" />
                    <Run Text="{}{title}" FontFamily="Consolas" />
                    <Run Text="," />
                    <Run Text="{}{artist}" FontFamily="Consolas" />
                    <Run Text="," />
                    <Run Text="{}{album}" FontFamily="Consolas" />
                    <Run Text="— use / to create subfolders." />
                </TextBlock>
                <TextBox x:Name="RenamePatternBox" Header="Pattern" Text="{}{artist}/{album}/{title}" />
            </StackPanel>
        </ContentDialog>
    </Grid>
</Page>
