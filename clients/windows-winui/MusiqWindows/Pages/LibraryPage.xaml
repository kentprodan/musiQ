<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.LibraryPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MusiqWindows.ViewModels"
    mc:Ignorable="d">

    <Page.Resources>
        <MenuFlyout x:Key="RowMoreFlyout" x:Name="RowMoreFlyout">
            <MenuFlyoutItem Text="Edit tags…" Tag="edit" Click="RowMoreFlyoutItem_Click">
                <MenuFlyoutItem.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </MenuFlyoutItem.Icon>
            </MenuFlyoutItem>
        </MenuFlyout>
    </Page.Resources>

    <Grid x:Name="LibraryPageRoot" Padding="24,16,24,0" RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Library" />

        <CommandBar
            x:Name="LibraryCommandBar"
            Grid.Row="1"
            HorizontalAlignment="Left"
            Background="Transparent"
            DefaultLabelPosition="Right"
            IsOpen="False">
            <AppBarButton x:Name="ScanFolderButton" Label="Scan Folder…" Click="ScanFolderButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8DA;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="EditSelectedButton" Label="Edit Selected" Click="EditSelectedButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE70F;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarButton x:Name="RenameSelectedButton" Label="Rename Selected" Click="RenameSelectedButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8AC;" />
                </AppBarButton.Icon>
            </AppBarButton>
            <AppBarSeparator />
            <AppBarToggleButton x:Name="SelectionCheckboxesToggle" Label="Selection checkboxes" Click="SelectionCheckboxesToggle_Click">
                <AppBarToggleButton.Icon>
                    <FontIcon Glyph="&#xE9D5;" />
                </AppBarToggleButton.Icon>
            </AppBarToggleButton>
            <AppBarButton x:Name="ColumnsButton" Label="Columns…" Click="ColumnsButton_Click">
                <AppBarButton.Icon>
                    <FontIcon Glyph="&#xE8A9;" />
                </AppBarButton.Icon>
            </AppBarButton>
        </CommandBar>

        <StackPanel Grid.Row="2" Orientation="Horizontal" Spacing="8" VerticalAlignment="Center" Margin="0,0,0,4">
            <TextBlock Text="{x:Bind ViewModel.StatusMessage, Mode=OneWay}" Opacity="0.7" />
            <ProgressRing IsActive="{x:Bind ViewModel.IsScanning, Mode=OneWay}" Width="16" Height="16" />
        </StackPanel>

        <ListView
            x:Name="TracksListView"
            Grid.Row="3"
            Margin="-24,0,-24,0"
            Padding="24,0,24,0"
            ItemsSource="{x:Bind ViewModel.Tracks}"
            SelectionMode="Extended"
            ContainerContentChanging="TracksListView_ContainerContentChanging">
            <ListView.ItemContainerStyle>
                <Style TargetType="ListViewItem">
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="MinHeight" Value="40" />
                </Style>
            </ListView.ItemContainerStyle>
            <ListView.ItemTemplate>
                <DataTemplate x:DataType="viewmodels:TrackItem">
                    <Grid
                        MinHeight="40"
                        Background="Transparent"
                        Tag="{x:Bind}"
                        DoubleTapped="TrackRow_DoubleTapped"
                        PointerEntered="TrackRow_PointerEntered"
                        PointerExited="TrackRow_PointerExited">
                        <Button
                            x:Name="RowPlayButton"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Tag="{x:Bind}"
                            Click="RowPlayButton_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE768;" FontSize="12" />
                        </Button>
                        <TextBlock x:Name="TitleText" Text="{x:Bind Title}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="TimeText" Text="{x:Bind Duration}" Margin="12,0,12,0" VerticalAlignment="Center" Opacity="0.7" />
                        <TextBlock x:Name="ArtistText" Text="{x:Bind Artist}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="AlbumText" Text="{x:Bind Album}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <TextBlock x:Name="YearText" Text="{x:Bind Year}" Margin="12,0,12,0" VerticalAlignment="Center" />
                        <TextBlock x:Name="GenreText" Text="{x:Bind Genre}" Margin="12,0,12,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis" />
                        <Button
                            x:Name="RowMoreButton"
                            Padding="8,4"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Visibility="Collapsed"
                            Tag="{x:Bind}"
                            Click="RowMoreButton_Click">
                            <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE712;" FontSize="14" />
                        </Button>
                    </Grid>
                </DataTemplate>
            </ListView.ItemTemplate>
        </ListView>

        <ContentDialog
            x:Name="EditTrackDialog"
            Title="Edit tags"
            PrimaryButtonText="Save"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <TextBox x:Name="EditTitleBox" Header="Title" />
                <TextBox x:Name="EditArtistBox" Header="Artist" />
                <TextBox x:Name="EditAlbumBox" Header="Album" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="BatchEditDialog"
            Title="Edit tags for selected tracks"
            PrimaryButtonText="Save"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="320">
                <TextBlock Text="Leave a field blank to keep each track's existing value." Opacity="0.7" TextWrapping="Wrap" />
                <TextBox x:Name="BatchArtistBox" Header="Artist" />
                <TextBox x:Name="BatchAlbumBox" Header="Album" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="RenamePatternDialog"
            Title="Rename selected tracks"
            PrimaryButtonText="Rename"
            CloseButtonText="Cancel"
            DefaultButton="Primary">
            <StackPanel Spacing="12" MinWidth="360">
                <TextBlock Opacity="0.7" TextWrapping="Wrap">
                    <Run Text="Files move into the folder you just picked, using this pattern. Placeholders:" />
                    <Run Text="{}{title}" FontFamily="Consolas" />
                    <Run Text="," />
                    <Run Text="{}{artist}" FontFamily="Consolas" />
                    <Run Text="," />
                    <Run Text="{}{album}" FontFamily="Consolas" />
                    <Run Text="— use / to create subfolders." />
                </TextBlock>
                <TextBox x:Name="RenamePatternBox" Header="Pattern" Text="{}{artist}/{album}/{title}" />
            </StackPanel>
        </ContentDialog>

        <ContentDialog
            x:Name="CustomizeColumnsDialog"
            Title="Customize columns"
            PrimaryButtonText="Close"
            DefaultButton="Primary">
            <StackPanel x:Name="CustomizeColumnsPanel" Spacing="8" MinWidth="280" />
        </ContentDialog>
    </Grid>
</Page>
