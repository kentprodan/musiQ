<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.SettingsLibrarySourcesPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Padding="24,16,0,0" VerticalAlignment="Center">
            <HyperlinkButton Padding="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ElementSoundMode="FocusOnly" Click="BackToSettingsHome_Click">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock Text="&gt;" Style="{StaticResource TitleTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock x:Name="SectionLabelText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000"
                    Padding="24,0,24,24"
                    Spacing="{StaticResource SettingsCardSpacing}">
                    <TextBlock
                        Text="Connect Plex and Navidrome servers here — browsing them happens from the sidebar once connected."
                        Opacity="0.7"
                        TextWrapping="Wrap"
                        Margin="1,0,0,6" />
                    <Border
                        Background="{ThemeResource CardBackgroundFillColorDefaultBrush}"
                        BorderBrush="{ThemeResource CardStrokeColorDefaultBrush}"
                        BorderThickness="1"
                        CornerRadius="{StaticResource ControlCornerRadius}"
                        Padding="0">
                        <Frame x:Name="SourcesSectionFrame" MinHeight="200" />
                    </Border>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
