<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.SettingsAppearancePage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:controls="using:CommunityToolkit.WinUI.Controls"
    xmlns:ui="using:CommunityToolkit.WinUI"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    mc:Ignorable="d">

    <Grid RowSpacing="8">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <StackPanel Grid.Row="0" Orientation="Horizontal" Spacing="4" Padding="24,16,0,0" VerticalAlignment="Center">
            <HyperlinkButton Padding="0" Foreground="{ThemeResource TextFillColorSecondaryBrush}" VerticalAlignment="Center" ElementSoundMode="FocusOnly" Click="BackToSettingsHome_Click">
                <TextBlock Text="Settings" Style="{StaticResource TitleTextBlockStyle}" />
            </HyperlinkButton>
            <TextBlock Text="&gt;" Style="{StaticResource TitleTextBlockStyle}" Opacity="0.6" VerticalAlignment="Center" />
            <TextBlock x:Name="SectionLabelText" Style="{StaticResource TitleTextBlockStyle}" VerticalAlignment="Center" />
        </StackPanel>

        <ScrollViewer Grid.Row="1">
            <Grid>
                <StackPanel
                    HorizontalAlignment="Stretch"
                    MaxWidth="1000"
                    Padding="24,0,24,24"
                    Spacing="{StaticResource SettingsCardSpacing}">
                    <controls:SettingsCard Header="App theme" Description="Select which app theme to display" HeaderIcon="{ui:FontIcon Glyph=&#xE790;}">
                        <ComboBox x:Name="ThemeComboBox" Width="200" SelectionChanged="ThemeComboBox_SelectionChanged">
                            <ComboBoxItem Content="Use system setting" Tag="System" />
                            <ComboBoxItem Content="Light" Tag="Light" />
                            <ComboBoxItem Content="Dark" Tag="Dark" />
                        </ComboBox>
                    </controls:SettingsCard>

                    <controls:SettingsCard Header="Sound" Description="Controls provide audible feedback" HeaderIcon="{ui:FontIcon Glyph=&#xEC4F;}">
                        <ToggleSwitch IsOn="{x:Bind ViewModel.UiSoundEnabled, Mode=TwoWay}" OnContent="On" OffContent="Off" />
                    </controls:SettingsCard>
                </StackPanel>
            </Grid>
        </ScrollViewer>
    </Grid>
</Page>
