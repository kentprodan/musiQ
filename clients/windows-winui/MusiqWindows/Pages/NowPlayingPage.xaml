<?xml version="1.0" encoding="utf-8" ?>
<Page
    x:Class="MusiqWindows.Pages.NowPlayingPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:local="using:MusiqWindows.Pages"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:viewmodels="using:MusiqWindows.ViewModels"
    mc:Ignorable="d">

    <Grid Padding="24,16,24,16" RowSpacing="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>
        <TextBlock Style="{StaticResource TitleTextBlockStyle}" Text="Now Playing" />

        <StackPanel Grid.Row="1" Spacing="20" VerticalAlignment="Top">
            <StackPanel Spacing="4">
                <TextBlock Text="{x:Bind ViewModel.TrackTitle, Mode=OneWay}" Style="{StaticResource SubtitleTextBlockStyle}" />
                <TextBlock Text="{x:Bind ViewModel.TrackArtist, Mode=OneWay}" Opacity="0.7" />
            </StackPanel>

            <StackPanel Spacing="4" MaxWidth="480" HorizontalAlignment="Left">
                <Slider
                    x:Name="PositionSlider"
                    Width="480"
                    Minimum="0"
                    Maximum="{x:Bind ViewModel.DurationSecs, Mode=OneWay}"
                    IsEnabled="{x:Bind ViewModel.CanSeek, Mode=OneWay}"
                    PointerPressed="PositionSlider_PointerPressed"
                    PointerCaptureLost="PositionSlider_PointerCaptureLost" />
                <StackPanel Orientation="Horizontal">
                    <TextBlock x:Name="PositionText" Text="0:00" Opacity="0.7" FontSize="12" />
                    <TextBlock Text=" / " Opacity="0.7" FontSize="12" />
                    <TextBlock Text="{x:Bind ViewModel.DurationText, Mode=OneWay}" Opacity="0.7" FontSize="12" />
                </StackPanel>
            </StackPanel>

            <StackPanel Orientation="Horizontal" Spacing="8">
                <Button
                    Command="{x:Bind ViewModel.ToggleShuffleCommand}"
                    Opacity="{x:Bind ViewModel.ShuffleOpacity, Mode=OneWay}"
                    Width="40"
                    HorizontalContentAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE8B1;" FontSize="14" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.PreviousCommand}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Width="40"
                    HorizontalContentAlignment="Center"
                    ElementSoundMode="FocusOnly">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE892;" FontSize="14" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.PlayPauseCommand}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Width="48"
                    HorizontalContentAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{x:Bind ViewModel.PlayPauseGlyph, Mode=OneWay}" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.NextCommand}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Width="40"
                    HorizontalContentAlignment="Center"
                    ElementSoundMode="FocusOnly">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE893;" FontSize="14" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.StopCommand}"
                    IsEnabled="{x:Bind ViewModel.HasTrack, Mode=OneWay}"
                    Width="40"
                    HorizontalContentAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="&#xE71A;" FontSize="14" />
                </Button>
                <Button
                    Command="{x:Bind ViewModel.CycleRepeatModeCommand}"
                    Opacity="{x:Bind ViewModel.RepeatOpacity, Mode=OneWay}"
                    Width="40"
                    HorizontalContentAlignment="Center">
                    <FontIcon FontFamily="{StaticResource SymbolThemeFontFamily}" Glyph="{x:Bind ViewModel.RepeatGlyph, Mode=OneWay}" FontSize="14" />
                </Button>
            </StackPanel>

            <StackPanel Spacing="8" MaxWidth="480" HorizontalAlignment="Left">
                <TextBlock Text="Up next" Style="{StaticResource SubtitleTextBlockStyle}" FontSize="16" />
                <ListView
                    ItemsSource="{x:Bind ViewModel.UpNext}"
                    SelectionMode="None"
                    IsItemClickEnabled="True"
                    ItemClick="UpNextListView_ItemClick"
                    Height="280">
                    <ListView.ItemTemplate>
                        <DataTemplate x:DataType="viewmodels:QueueItemDisplay">
                            <Grid Padding="8,6" ColumnSpacing="8">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="20" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <FontIcon
                                    Grid.Column="0"
                                    FontFamily="{StaticResource SymbolThemeFontFamily}"
                                    Glyph="&#xE768;"
                                    FontSize="10"
                                    Visibility="{x:Bind IsCurrent}" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="{x:Bind Track.Title}" Opacity="{x:Bind TitleOpacity}" />
                                    <TextBlock Text="{x:Bind Track.Artist}" Opacity="0.7" FontSize="11" />
                                </StackPanel>
                            </Grid>
                        </DataTemplate>
                    </ListView.ItemTemplate>
                </ListView>
            </StackPanel>
        </StackPanel>
    </Grid>
</Page>
